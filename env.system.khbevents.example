# Example .env for system.khbevents.com (production)
# Copy to .env on the server: cp env.system.khbevents.example .env
# Then set DB_PASSWORD and run: php artisan key:generate --force

APP_NAME="KHB Booths Booking System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://system.khbevents.com
APP_TIMEZONE=Asia/Phnom_Penh

# cPanel MySQL credentials
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=khbevents_aebooths
DB_USERNAME=khbevents_admaebooths
DB_PASSWORD=

# Session Configuration (Production)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Logging Configuration (Production)
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAYS=14

# Cache Configuration (Production - upgrade to Redis when available)
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Mail Configuration (SendGrid - to be configured)
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@khbevents.com
MAIL_FROM_NAME="${APP_NAME}"

# Telegram Bot (Activity Notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ACTIVITY_ENABLED=true

# Push Notifications (Web Push / VAPID)
PUSH_NOTIFICATIONS_ENABLED=true
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
